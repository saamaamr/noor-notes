<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="noor-oled" _name="Noor OLED" version="1.0" parent-scheme="Adwaita-dark">
  <_description>Noor Notes OLED source editor</_description>
  <metadata><property name="variant">dark</property></metadata>
  <style name="text" foreground="#fafaff" background="#121216"/>
  <style name="cursor" foreground="#b1a0ff"/>
  <style name="line-numbers" foreground="#bdbdc7" background="#0a0a0c"/>
  <style name="current-line-number" foreground="#b1a0ff" background="#19191f" bold="true"/>
  <style name="current-line" background="#19191f"/>
  <style name="selection" foreground="#ffffff" background="#44366f"/>
  <style name="search-match" foreground="#ffffff" background="#67541f"/>
  <style name="bracket-match" foreground="#b1a0ff" bold="true"/>
  <style name="def:comment" foreground="#bdbdc7" italic="true"/>
  <style name="def:keyword" foreground="#b1a0ff" bold="true"/>
  <style name="def:string" foreground="#82dda8"/>
  <style name="def:number" foreground="#debaff"/>
  <style name="def:constant" foreground="#debaff"/>
  <style name="def:type" foreground="#8fceff" bold="true"/>
  <style name="def:function" foreground="#ffca82"/>
  <style name="def:heading" foreground="#b1a0ff" bold="true"/>
  <style name="def:link-destination" foreground="#8fceff" underline="single"/>
  <style name="def:error" foreground="#ff8c92" underline="error" underline-color="#ff8c92"/>
</style-scheme>
