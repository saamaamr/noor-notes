<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.saamaamr.NoorNotes</id>
  <name>Noor Notes</name>
  <summary>Private, offline-first sticky notes for Linux</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.saamaamr">
    <name>Abdullah Al Mamun</name>
  </developer>
  <description>
    <p>Noor Notes is a native Linux application for private, offline-first sticky notes.</p>
    <p>Create richly formatted notes, organize them in a searchable library, and recover notes from Trash when needed. Noor Notes can import existing Xpad notes without changing the original files, and optional encrypted synchronization is available when configured.</p>
  </description>
  <launchable type="desktop-id">io.github.saamaamr.NoorNotes.desktop</launchable>
  <url type="homepage">https://github.com/saamaamr/noor-notes</url>
  <url type="bugtracker">https://github.com/saamaamr/noor-notes/issues</url>
  <url type="vcs-browser">https://github.com/saamaamr/noor-notes</url>
  <content_rating type="oars-1.1"/>
